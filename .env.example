PORT=3000
NODE_ENV=development
TLS_MODE=local
TLS_KEY_PATH=certs/localhost-key.pem
TLS_CERT_PATH=certs/localhost.pem
MONGODB_URI=mongodb://127.0.0.1:27017/airlineDB
SESSION_SECRET=replace-with-a-long-random-secret
PASSPORT_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
ADMIN_EMAIL=admin@yourdomain.com
DPO_CONTACT=configure-the-approved-DPO-contact
