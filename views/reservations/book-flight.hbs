<main class="booking-page container-fluid my-5 px-4">
  <div class="card shadow-lg mx-auto" style="max-width: 900px;">
    <div class="card-header bg-danger text-white text-center py-3">
      <h3>Book Your Flight</h3>
    </div>
    <div class="card-body">
      <div class="alert alert-danger text-center fw-semibold mt-2">
        <strong>Select your route and flights</strong>
      </div>
      <div id="flightSearchForm" class="mb-4">
        <div class="row g-3 justify-content-center">
          <label class="col-md-5">Origin
            <select id="origin" class="form-select" required>
              <option value="">-- Select Origin --</option>
              {{#each origins}}<option value="{{this}}">{{this}}</option>{{/each}}
            </select>
          </label>
          <label class="col-md-5">Destination
            <select id="destination" class="form-select" required>
              <option value="">-- Select Destination --</option>
              {{#each destinations}}<option value="{{this}}">{{this}}</option>{{/each}}
            </select>
          </label>
        </div>
        <div class="row g-3 mt-3 justify-content-center">
          <label class="col-md-4">Trip type
            <select id="tripTypeSelect" class="form-select">
              <option value="One-Way">One-Way</option>
              <option value="Round-Trip">Round-Trip</option>
            </select>
          </label>
          <label class="col-md-4">Travel class
            <select id="travelClassSelect" class="form-select">
              <option value="Economy">Economy</option>
              <option value="Premium Economy">Premium Economy</option>
              <option value="Business">Business</option>
              <option value="First">First</option>
            </select>
          </label>
        </div>
      </div>

      <div id="flightSelection" class="alert alert-info text-center fw-semibold d-none mt-4">
        <h5 class="text-danger fw-bold mb-2">Select available flight(s)</h5>
        <label class="w-100">Outbound flight
          <select id="outboundFlight" class="form-select text-center mb-3">
            <option value="">-- Choose Outbound Flight --</option>
          </select>
        </label>
        <div id="returnFlightSection" class="d-none">
          <label class="w-100">Return flight
            <select id="returnFlight" class="form-select text-center">
              <option value="">-- Choose Return Flight --</option>
            </select>
          </label>
        </div>
      </div>

      <form id="reservationForm" action="/reservations/create" method="POST" class="needs-validation d-none mt-4" novalidate>
        <div class="alert alert-info">
          I have told each passenger how their name, age category and passport number will be used. See the
          <a href="/privacy-policy">Privacy Notice</a>.
          <label class="d-block mt-2"><input id="passengerNoticeAccepted" type="checkbox" required>
            I confirm the passenger notice was provided.</label>
        </div>
        <div class="row mb-3">
          <label class="col-md-4">Number of passengers
            <input type="number" id="passengerCount" class="form-control" min="1" max="10" value="1" required>
          </label>
        </div>
        <div id="passengerFields"></div>
        <h5 class="text-center text-danger mt-4">Outbound seat selection</h5>
        <div id="seat-map-outbound" class="my-3 d-flex flex-wrap justify-content-center"></div>
        <section id="returnSeatSection" class="d-none">
          <h5 class="text-center text-danger mt-4">Return seat selection</h5>
          <div id="seat-map-return" class="my-3 d-flex flex-wrap justify-content-center"></div>
        </section>
        <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
          <span class="badge bg-danger">First Class</span>
          <span class="badge bg-light text-dark border border-purple">Business</span>
          <span class="badge bg-info text-dark">Premium Economy</span>
          <span class="badge bg-primary">Economy</span>
          <span class="badge bg-secondary">Occupied</span>
          <span class="badge bg-warning text-dark">Selected</span>
        </div>
        <div class="card bg-light p-3 mb-4 summary-card mx-auto">
          <h5 class="text-danger fw-bold">Price summary (estimate)</h5>
          <p>Outbound fare: ₱<span id="baseFare">0</span></p>
          <p>Return fare: ₱<span id="returnFare">0</span></p>
          <p>Meal total: ₱<span id="mealFee">0</span></p>
          <p>Baggage total: ₱<span id="baggageFee">0</span></p>
          <p>Seat total: ₱<span id="seatFee">0</span></p>
          <hr>
          <h5>Total estimate: ₱<span id="totalPrice">0</span></h5>
        </div>
        <div id="formMessage" class="text-danger mb-3" role="alert"></div>
        <div class="d-flex justify-content-center gap-2">
          <button type="submit" id="confirmBooking" class="btn btn-danger px-4">Confirm booking</button>
        </div>
      </form>
    </div>
  </div>
</main>
