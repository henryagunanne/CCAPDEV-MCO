<main class="booking-page container-fluid my-5 px-4">
  <div class="card shadow-lg mx-auto" style="max-width: 900px;">
    <div class="card-header bg-danger text-white text-center py-3">
      <h3>Edit Reservation – {{outboundFlight.flightNumber}}{{#if returnFlight}} / {{returnFlight.flightNumber}}{{/if}}</h3>
      <p class="mb-1">{{outboundFlight.origin}} → {{outboundFlight.destination}}</p>
      {{#if returnFlight}}<p class="mb-0">{{returnFlight.origin}} → {{returnFlight.destination}}</p>{{/if}}
    </div>
    <div class="alert alert-danger text-center fw-semibold mt-3">
      You can update meals, baggage, and seat assignments. Passenger identity and flights remain unchanged.
    </div>
    <div class="card-body">
      <form id="editReservationForm" method="POST" action="/reservations/{{reservation._id}}/edit"
            data-reservation-id="{{reservation._id}}"
            data-outbound-id="{{outboundFlight._id}}"
            data-return-id="{{returnFlight._id}}"
            data-travel-class="{{reservation.travelClass}}">
        <input type="hidden" name="totalPrice" id="totalPriceInput">
        <input type="hidden" name="passengersJSON" id="passengersJSON">
        <div id="passengerFields">
          {{#each reservation.passengers}}
          <section class="card my-3 shadow-sm passenger-card"
                   data-seat-outbound="{{this.seatNumber}}"
                   data-seat-return="{{this.returnSeatNumber}}"
                   data-full-name="{{this.fullName}}"
                   data-age="{{this.age}}"
                   data-gender="{{this.gender}}"
                   data-passport="{{this.passport}}">
            <div class="card-header bg-light"><strong>Passenger {{inc @index}}</strong></div>
            <div class="card-body">
              <p class="mb-1">{{this.fullName}} · {{this.gender}} · Age {{this.age}}</p>
              <p class="text-muted small">Passport: {{this.passport}}</p>
              <div class="row">
                <label class="col-md-6">Meal
                  <select class="form-select meal-option">
                    <option value="None" {{#if (eq this.meal "None")}}selected{{/if}}>None</option>
                    <option value="Vegetarian" {{#if (eq this.meal "Vegetarian")}}selected{{/if}}>Vegetarian</option>
                    <option value="Non-Vegetarian" {{#if (eq this.meal "Non-Vegetarian")}}selected{{/if}}>Non-Vegetarian</option>
                    <option value="Vegan" {{#if (eq this.meal "Vegan")}}selected{{/if}}>Vegan</option>
                    <option value="Gluten-Free" {{#if (eq this.meal "Gluten-Free")}}selected{{/if}}>Gluten-Free</option>
                  </select>
                </label>
                <label class="col-md-6">Baggage (kg)
                  <input class="form-control baggage-input" type="number" min="0" max="40" step="1" value="{{this.baggageAllowance}}">
                </label>
              </div>
              <div class="small text-muted mt-2">Outbound seat: <span class="seat-label-outbound">{{this.seatNumber}}</span></div>
              {{#if returnFlight}}
              <div class="small text-muted">Return seat: <span class="seat-label-returning">{{this.returnSeatNumber}}</span></div>
              {{/if}}
            </div>
          </section>
          {{/each}}
        </div>

        <h5 class="text-center text-danger mt-4">Outbound seat selection</h5>
        <div id="seat-map-outbound" class="my-3 d-flex flex-wrap justify-content-center"></div>
        {{#if returnFlight}}
        <h5 class="text-center text-danger mt-4">Return seat selection</h5>
        <div id="seat-map-return" class="my-3 d-flex flex-wrap justify-content-center"></div>
        {{/if}}
        <div class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
          <span class="badge bg-danger">First</span>
          <span class="badge bg-light text-dark border border-purple">Business</span>
          <span class="badge bg-info text-dark">Premium Economy</span>
          <span class="badge bg-primary">Economy</span>
          <span class="badge bg-secondary">Occupied</span>
          <span class="badge bg-warning text-dark">Selected</span>
        </div>
        <div class="card bg-light p-3 mb-4 summary-card mx-auto">
          <h5 class="text-danger fw-bold">Updated price estimate</h5>
          <p>Outbound fare: ₱<span id="baseFare" data-fare="{{outboundFlight.price}}">{{outboundFlight.price}}</span></p>
          {{#if returnFlight}}<p>Return fare: ₱<span id="returnFare" data-fare="{{returnFlight.price}}">{{returnFlight.price}}</span></p>{{/if}}
          <p>Meal total: ₱<span id="mealFee">0</span></p>
          <p>Baggage total: ₱<span id="baggageFee">0</span></p>
          <p>Seat total: ₱<span id="seatFee">0</span></p>
          <hr>
          <h5>Total: ₱<span id="totalPrice">{{reservation.price}}</span></h5>
        </div>
        <div id="formMessage" class="text-danger mb-3" role="alert"></div>
        <div class="d-flex justify-content-center gap-2">
          <button type="submit" class="btn btn-danger px-4">Save changes</button>
          <a href="/reservations/my-bookings" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</main>
<script src="/src/javascript/edit-reservation.js"></script>
